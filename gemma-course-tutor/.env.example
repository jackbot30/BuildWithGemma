# Copy to .env and adjust. All config in one place.

# Ollama endpoint (local only — content never leaves the machine)
OLLAMA_URL=http://localhost:11434

# Chat model tag as pulled in `ollama list`. NOTE: there is no public "gemma4"
# outside this machine — the current public family is Gemma 3. Point this at
# whatever you actually have pulled; no code changes needed to swap models.
GEMMA_MODEL=gemma4:e4b

# Embedding model for the RAG index (pull with: ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text

# Retrieval depth
TOP_K=5

# Where the local course pack lives (see course-pack/README.md)
COURSE_PACK_DIR=./course-pack
