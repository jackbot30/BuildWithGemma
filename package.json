{
  "name": "math-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "On-device Gemma 4 math tutor that teaches, graphs, and checks its own work — fully offline.",
  "scripts": {
    "server": "bun run server.ts",
    "app": "bun run server.ts --open",
    "eval": "bun run eval/run.ts",
    "vendor": "pwsh -NoProfile -File scripts/vendor-deps.ps1",
    "install-shortcut": "pwsh -NoProfile -File scripts/install-shortcut.ps1"
  },
  "dependencies": {
    "function-plot": "^1.25.4",
    "katex": "^0.16.11",
    "mathjs": "^14.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/katex": "^0.16.7",
    "typescript": "^5.6.0"
  }
}
